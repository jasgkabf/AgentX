FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    curl wget git vim nano \
    python3 python3-pip python3-venv \
    nodejs npm \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN npx playwright install --with-deps chromium

WORKDIR /opt/agent_runner
COPY agent_runner/requirements.txt ./agent_runner/
RUN pip3 install --no-cache-dir -r ./agent_runner/requirements.txt
RUN playwright install chromium

COPY agent_runner/ ./agent_runner/

RUN mkdir -p /workspace
WORKDIR /workspace

ENV PYTHONPATH=/opt/agent_runner

EXPOSE 6000

CMD ["python3", "-m", "uvicorn", "agent_runner.main:app", "--host", "0.0.0.0", "--port", "6000"]
